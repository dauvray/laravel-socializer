{
  "name": "dauvray/laravel-socializer",
  "description": "genaral functionality for Laravel CMS",
  "keywords": [
    "laravel",
    "cms"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "David Auvray",
      "email": "dauvray@outlook.fr"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^13.0",
    "cviebrock/eloquent-sluggable": "^13.0",
    "vesoft-inc/nebula-php": "dev-main"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Dauvray\\Socializer\\": "src/"
    },
    "files": []
  },
  "autoload-dev": {
    "psr-4": {
      "Dauvray\\Socializer\\Tests\\": "tests/",
      "App\\": "tests/Stubs/App/",
      "Dauvray\\Estarter\\": "tests/Stubs/Estarter/",
      "Innovation\\formdesigner\\": "tests/Stubs/Formdesigner/"
    },
    "files": [
      "tests/Stubs/helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Dauvray\\Socializer\\ServiceProvider"
      ],
      "aliases": {}
    }
  },
  "repositories": {}
}
